generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  locale       String   @default("pt-BR")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  interviewSessions InterviewSession[]
  knowledgeItems    KnowledgeItem[]
  criSnapshots      CriSnapshot[]
  diaryEntries      DiaryEntry[]
  learningEvents    LearningEvent[]
  questionAttempts  QuestionAttempt[]
  technicalAttempts TechnicalAttempt[]
  jobOpportunities  JobOpportunity[]
  jobApplications   JobApplication[]
  careerDocuments   CareerDocument[]
  companies         Company[]
  companyContacts   CompanyContact[]
  professionalEvidence ProfessionalEvidence[]
  competencyEvaluations CompetencyEvaluation[]

  @@map("users")
}

model JobOpportunity {
  id                  String   @id @default(uuid())
  userId              String   @map("user_id")
  title               String
  company             String
  country             String
  city                String?
  workModel           String   @map("work_model")
  seniority           String
  language            String
  link                String?
  originalDescription String   @map("original_description")
  status              String   @default("saved")
  favorite            Boolean  @default(false)
  notes               String?
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  companyProfileId    String?  @map("company_profile_id")

  user           User            @relation(fields: [userId], references: [id])
  companyProfile Company?        @relation(fields: [companyProfileId], references: [id], onDelete: SetNull)
  analysis       JobAnalysis?
  application    JobApplication?
  documents      CareerDocument[]
  competencyEvaluation CompetencyEvaluation?

  @@index([userId, status])
  @@index([userId, workModel])
  @@index([companyProfileId])
  @@map("job_opportunities")
}

model Company {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  website     String?
  linkedinUrl String?  @map("linkedin_url")
  country     String?
  city        String?
  industry    String?
  size        String?
  workCulture String?  @map("work_culture")
  notes       String?
  favorite    Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user          User             @relation(fields: [userId], references: [id])
  contacts      CompanyContact[]
  opportunities JobOpportunity[]

  @@unique([userId, name])
  @@index([userId, favorite])
  @@map("companies")
}

model CompanyContact {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  companyId     String    @map("company_id")
  name          String
  role          String?
  email         String?
  linkedinUrl   String?   @map("linkedin_url")
  notes         String?
  lastContactAt DateTime? @map("last_contact_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user    User    @relation(fields: [userId], references: [id])
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, updatedAt])
  @@index([userId, lastContactAt])
  @@map("company_contacts")
}

model JobApplication {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  opportunityId String    @unique @map("opportunity_id")
  status        String    @default("planned")
  appliedAt     DateTime? @map("applied_at")
  nextAction    String?   @map("next_action")
  nextActionAt  DateTime? @map("next_action_at")
  notes         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id])
  opportunity JobOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([userId, nextActionAt])
  @@map("job_applications")
}

model JobAnalysis {
  id                    String   @id @default(uuid())
  opportunityId         String   @unique @map("opportunity_id")
  technicalSummary      String   @map("technical_summary")
  responsibilities      Json
  requiredRequirements  Json     @map("required_requirements")
  preferredRequirements Json     @map("preferred_requirements")
  technologies          Json
  softSkills            Json     @map("soft_skills")
  estimatedSeniority    String   @map("estimated_seniority")
  profileFit            Json     @map("profile_fit")
  gaps                  Json
  preparationPlan       Json     @map("preparation_plan")
  providerName          String   @map("provider_name")
  modelName             String   @map("model_name")
  promptTemplateVersion String   @map("prompt_template_version")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  opportunity JobOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@map("job_analyses")
}

model CareerDocument {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  opportunityId         String   @map("opportunity_id")
  language              String
  candidateProfile      String   @map("candidate_profile")
  cvMarkdown            String   @map("cv_markdown")
  coverLetter           String   @map("cover_letter")
  fitMatrix             Json     @map("fit_matrix")
  sourceEvidenceIds     Json     @default("[]") @map("source_evidence_ids")
  providerName          String   @map("provider_name")
  modelName             String   @map("model_name")
  promptTemplateVersion String   @map("prompt_template_version")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id])
  opportunity JobOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@unique([opportunityId, language])
  @@index([userId, updatedAt])
  @@map("career_documents")
}

model ProfessionalEvidence {
  id          String    @id @default(uuid())
  userId      String    @map("user_id")
  type        String
  title       String
  description String
  skills      Json      @default("[]")
  outcome     String?
  sourceUrl   String?   @map("source_url")
  occurredAt  DateTime? @map("occurred_at")
  favorite    Boolean   @default(false)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId, type])
  @@index([userId, favorite])
  @@map("professional_evidence")
}

model CompetencyEvaluation {
  id                    String   @id @default(uuid())
  userId                String   @map("user_id")
  opportunityId         String   @unique @map("opportunity_id")
  summary               String
  overallScore          Float    @map("overall_score")
  requirements          Json
  evidenceIds           Json     @default("[]") @map("evidence_ids")
  analysisUpdatedAt     DateTime @map("analysis_updated_at")
  providerName          String   @map("provider_name")
  modelName             String   @map("model_name")
  promptTemplateVersion String   @map("prompt_template_version")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user        User           @relation(fields: [userId], references: [id])
  opportunity JobOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("competency_evaluations")
}

model InterviewSession {
  id               String    @id @default(uuid())
  userId           String    @map("user_id")
  language         String
  targetRole       String    @map("target_role")
  seniority        String
  topic            String
  interviewerStyle String?   @map("interviewer_style")
  difficulty       String
  status           String    @default("started")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")

  user           User             @relation(fields: [userId], references: [id])
  turns          InterviewTurn[]
  reports        FeedbackReport[]
  learningEvents LearningEvent[]

  @@map("interview_sessions")
}

model InterviewTurn {
  id         String   @id @default(uuid())
  sessionId  String   @map("session_id")
  orderIndex Int      @map("order_index")
  question   String
  answer     String?
  coachNote  String?  @map("coach_note")
  createdAt  DateTime @default(now()) @map("created_at")

  session InterviewSession @relation(fields: [sessionId], references: [id])

  @@map("interview_turns")
}

model FeedbackReport {
  id                    String   @id @default(uuid())
  sessionId             String   @map("session_id")
  overallSummary        String   @map("overall_summary")
  confidenceLevel       String   @map("confidence_level")
  modelName             String?  @map("model_name")
  promptTemplateVersion String?  @map("prompt_template_version")
  createdAt             DateTime @default(now()) @map("created_at")

  session    InterviewSession    @relation(fields: [sessionId], references: [id])
  dimensions FeedbackDimension[]

  @@map("feedback_reports")
}

model FeedbackDimension {
  id             String @id @default(uuid())
  reportId       String @map("report_id")
  dimension      String
  score          Float
  evidence       String
  recommendation String

  report FeedbackReport @relation(fields: [reportId], references: [id])

  @@map("feedback_dimensions")
}

model KnowledgeItem {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  type      String
  title     String
  body      String
  tags      Json?
  source    String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("knowledge_items")
}

model CriSnapshot {
  id              String   @id @default(uuid())
  userId          String   @map("user_id")
  score           Float
  confidenceLevel String   @map("confidence_level")
  composition     Json
  evidenceGaps    Json     @map("evidence_gaps")
  createdAt       DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@map("cri_snapshots")
}

model DiaryEntry {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  entryType String   @map("entry_type")
  title     String
  context   String?
  decision  String?
  nextSteps String?  @map("next_steps")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id])

  @@map("diary_entries")
}

model LearningEvent {
  id             String   @id @default(uuid())
  userId         String   @map("user_id")
  sessionId      String?  @map("session_id")
  concept        String
  helpLevel      String   @map("help_level")
  retryRequested Boolean  @default(false) @map("retry_requested")
  language       String   @default("pt-BR")
  content        Json
  createdAt      DateTime @default(now()) @map("created_at")

  user    User              @relation(fields: [userId], references: [id])
  session InterviewSession? @relation(fields: [sessionId], references: [id])

  @@map("learning_events")
}

model Question {
  id          String   @id @default(uuid())
  topic       String
  language    String   @default("pt-BR")
  level       Int
  type        String
  competency  String
  prompt      String
  criteria    Json
  hints       Json
  modelAnswer String   @map("model_answer")
  createdAt   DateTime @default(now()) @map("created_at")

  attempts QuestionAttempt[]

  @@map("questions")
}

model QuestionAttempt {
  id         String   @id @default(uuid())
  questionId String   @map("question_id")
  userId     String   @map("user_id")
  answer     String
  score      Float
  helpUsed   Boolean  @default(false) @map("help_used")
  result     String
  feedback   Json
  createdAt  DateTime @default(now()) @map("created_at")

  question Question @relation(fields: [questionId], references: [id])
  user     User     @relation(fields: [userId], references: [id])

  @@map("question_attempts")
}

model TechnicalChallenge {
  id                 String   @id @default(uuid())
  area               String
  title              String
  difficulty         String
  context            String
  evaluationCriteria Json     @map("evaluation_criteria")
  modelSolution      String   @map("model_solution")
  createdAt          DateTime @default(now()) @map("created_at")

  attempts TechnicalAttempt[]

  @@map("technical_challenges")
}

model TechnicalAttempt {
  id               String   @id @default(uuid())
  challengeId      String   @map("challenge_id")
  userId           String   @map("user_id")
  answer           String
  feedback         Json
  solutionRevealed Boolean  @default(false) @map("solution_revealed")
  createdAt        DateTime @default(now()) @map("created_at")

  challenge TechnicalChallenge @relation(fields: [challengeId], references: [id])
  user      User               @relation(fields: [userId], references: [id])

  @@map("technical_attempts")
}
